# =============================================================================
# TenderScout AI (Hueri) — environment template
# Copy to `.env` (dev) or `.env.production` (prod) and fill in real values.
# NEVER commit the filled-in file.
# =============================================================================

# --- Application ---
PROJECT_NAME="TenderScout AI"
# "development" enables alert log-fallbacks; "production" sends for real
ENVIRONMENT="development"
DEBUG=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated origins allowed by CORS (add your prod domain in production)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# --- Database ---
# Dev default (SQLite). Production example:
# DATABASE_URL="postgresql+asyncpg://user:password@db:5432/tenderscout"
DATABASE_URL="sqlite+aiosqlite:///./tenderscout.db"

# --- AI agent ---
GEMINI_API_KEY=""

# --- Alerts: email (SMTP - works with Gmail Workspace, Zoho, SES, Hostinger...) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="tenders@hueri.co.ke"
SMTP_USE_TLS=true
# Comma-separated management recipients
ALERT_EMAIL_RECIPIENTS=""

# --- Alerts: SMS (generic JSON gateway) ---
# Works with any gateway accepting a JSON POST. Example for Africa's Talking:
#   SMS_API_URL="https://api.africastalking.com/version1/messaging"
#   SMS_PAYLOAD_TEMPLATE='{"username":"myuser","to":["{to}"],"message":"{message}"}'
#   SMS_HEADERS='{"apiKey":"AT-KEY","Content-Type":"application/json","Accept":"application/json"}'
# Or Telnyx:
#   SMS_API_URL="https://api.telnyx.com/v2/messages"
#   SMS_PAYLOAD_TEMPLATE='{"to":"{to}","from":"+2547XXXXXXXX","text":"{message}"}'
#   SMS_HEADERS='{"Authorization":"Bearer TELNYX_KEY","Content-Type":"application/json"}'
SMS_API_URL=""
SMS_PAYLOAD_TEMPLATE=""
SMS_HEADERS=""
# Comma-separated management phone numbers in E.164 (e.g. +2547XXXXXXXX)
ALERT_SMS_RECIPIENTS=""

# --- Alerts: behaviour ---
# Relevance score (0-10) above which management gets notified
ALERT_MIN_SCORE=7.0
ALERTS_ENABLED=true

# --- Redis (leave empty to disable caching; compose sets redis://redis:6379/0) ---
REDIS_URL=""

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_EXPENSIVE="2/minute"
